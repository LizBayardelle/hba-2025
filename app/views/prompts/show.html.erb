<style>
  /* Visible by default; only fades out on devices that can actually hover */
  .prompt-log-actions { opacity: 1; transition: opacity 0.15s ease; }
  .prompt-grid-row:hover .prompt-log-actions { opacity: 1; }

  .prompt-grid {
    width: auto;
    min-width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
  }
  .prompt-grid thead th {
    position: sticky;
    top: 0;
    background: var(--surface);
    text-align: left;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
    z-index: 2;
    min-width: 140px;
  }
  .prompt-grid tbody td {
    padding: 12px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    color: var(--ink);
    line-height: 1.45;
    min-width: 140px;
  }
  .prompt-grid tbody tr:hover td { background: var(--hover-tint); }
  .prompt-grid .col-when,
  .prompt-grid td.col-when {
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    font-size: 0.78rem;
    min-width: 140px;
    width: 140px;
    position: sticky;
    left: 0;
    background: var(--surface);
    z-index: 1;
  }
  .prompt-grid tbody tr:hover td.col-when { background: var(--hover-tint); }
  .prompt-grid thead th.col-when { z-index: 3; }
  .prompt-grid .col-when .time-sub {
    display: block;
    font-weight: 400;
    color: var(--ink-tertiary);
    font-size: 0.72rem;
  }
  /* Actions pinned to the right edge so Edit is always reachable
     without scrolling the full width of the table. */
  .prompt-grid .col-actions,
  .prompt-grid td.col-actions,
  .prompt-grid th.col-actions {
    width: 1%;
    min-width: 0;
    padding: 8px 10px;
    white-space: nowrap;
    position: sticky;
    right: 0;
    background: var(--surface);
    z-index: 1;
    border-left: 1px solid var(--border);
    text-align: center;
  }
  .prompt-grid tbody tr:hover td.col-actions { background: var(--hover-tint); }
  .prompt-grid thead th.col-actions { z-index: 3; }

  /* Actions are always visible on touch devices — hover can't reveal them */
  @media (hover: hover) {
    .prompt-log-actions { opacity: 0; }
  }

  /* Keep any one column from stretching the row out of legibility */
  .prompt-grid tbody td { max-width: 320px; overflow-wrap: anywhere; }
  .prompt-grid .cell-long {
    min-width: 240px;
    max-width: 320px;
  }
  .clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* An answer recorded under a previous question type — shown rather than
     hidden behind a dash, but visibly distinct from a current-format value. */
  .prompt-legacy-value {
    color: var(--ink-secondary);
    font-style: italic;
  }
  .prompt-legacy-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 700;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-tertiary);
    background: var(--hover-tint-strong);
    border-radius: 6px;
    padding: 1px 6px;
    margin-right: 6px;
    vertical-align: 1px;
  }
  .prompt-grid-scroll {
    overflow-x: auto;
    overflow-y: visible;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }

  /* ── Card layout for narrow screens ── */
  .prompt-cards { display: none; }

  .prompt-response-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    padding: 14px 16px;
    margin-bottom: 12px;
  }
  .prompt-response-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    margin-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }
  .prompt-response-field + .prompt-response-field { margin-top: 12px; }
  .prompt-response-label {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--ink-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 3px;
  }
  .prompt-response-answer {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .prompt-grid-scroll { display: none; }
    .prompt-cards { display: block; }
  }
</style>

<div class="flex h-screen relative" style="background-color: var(--bg);">
  <%= render 'shared/sidebar' %>

  <main class="flex-1 overflow-y-auto md:ml-[224px]">
    <% color = @prompt.category&.color || '#8E8E93' %>
    <%# Prompt editing lives on /prompts/:id/edit now; this page only tracks
        which response's edit modal is open. %>
    <div x-data='{ "editingId": null }'>

      <!-- Header -->
      <div class="sticky top-0 z-10" style="background: var(--bg);">
          <%# On phones the header clears the fixed hamburger by sitting *below*
              it (pt-16) rather than beside it, so the title gets the full width
              and lines up with the log content, which is px-4. %>
        <div class="px-4 pt-16 pb-4 md:pl-8 md:pr-8 md:pt-8 md:pb-5">
          <%# Stacked on phones so the title/meta get the full width; the
              action buttons only sit alongside once there's room for them. %>
          <div class="flex flex-col gap-3 md:flex-row md:items-baseline md:justify-between md:gap-4">
            <div style="min-width: 0; flex: 1;">
              <%= link_to prompts_path, class: "v2-caption", style: "text-decoration: none; color: var(--ink-tertiary); display: inline-flex; align-items: center; gap: 4px; margin-bottom: 6px;" do %>
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Prompts
              <% end %>
              <div class="flex items-stretch gap-3">
                <%# stretches rather than fixed-height so it still matches a
                    title that wraps to two or three lines on a narrow screen %>
                <div style="width: 6px; min-height: 32px; background: <%= color %>; border-radius: 3px; flex-shrink: 0;"></div>
                <h1 class="v2-h1" style="margin: 0; min-width: 0; overflow-wrap: anywhere;"><%= @prompt.title %></h1>
              </div>
              <div class="flex items-center gap-3 flex-wrap" style="margin-top: 6px;">
                <span class="v2-small" style="color: var(--ink-tertiary);"><%= @responses.count %> response<%= @responses.count == 1 ? '' : 's' %></span>
                <span class="v2-caption" style="text-transform: uppercase; letter-spacing: 0.04em;"><%= @questions.count %> question<%= @questions.count == 1 ? '' : 's' %></span>
                <% if @prompt.category %>
                  <span class="v2-caption" style="color: <%= color %>;"><%= @prompt.category.name %></span>
                <% end %>
                <% @prompt.tags.each do |tag| %>
                  <span class="v2-caption" style="color: var(--ink-tertiary);">#<%= tag.name %></span>
                <% end %>
              </div>
            </div>
            <% header_btn_style = "display: inline-flex; align-items: center; gap: 6px; line-height: 1;" %>
            <div class="flex items-center gap-2 flex-wrap" style="flex-shrink: 0;">
              <%= link_to edit_prompt_path(@prompt), class: "v2-btn-sm v2-btn-secondary", style: header_btn_style, title: "Edit prompt" do %>
                <i class="fa-solid fa-pen" style="font-size: 0.7rem;"></i>
                <span>Edit</span>
              <% end %>
              <% if @prompt.archived? %>
                <%= button_to unarchive_prompt_path(@prompt), method: :patch, class: "v2-btn-sm v2-btn-secondary", style: header_btn_style do %>
                  <i class="fa-solid fa-box-open" style="font-size: 0.7rem;"></i>
                  <span>Unarchive</span>
                <% end %>
              <% else %>
                <%= button_to archive_prompt_path(@prompt), method: :patch, class: "v2-btn-sm v2-btn-secondary", style: header_btn_style do %>
                  <i class="fa-solid fa-box-archive" style="font-size: 0.7rem;"></i>
                  <span>Archive</span>
                <% end %>
              <% end %>
              <%= button_to prompt_path(@prompt), method: :delete, data: { confirm: "Delete this prompt and all #{@responses.count} responses?" }, class: "v2-btn-sm v2-btn-secondary", style: "#{header_btn_style} color: #C04040;" do %>
                <i class="fa-solid fa-trash" style="font-size: 0.7rem;"></i>
                <span>Delete</span>
              <% end %>
            </div>
          </div>
        </div>
        <div style="height: 12px; background: linear-gradient(to bottom, var(--bg), transparent); pointer-events: none;"></div>
      </div>

      <!-- Flash -->
      <% if flash[:notice] %>
        <div class="px-4 md:px-8" style="max-width: 760px; margin: 0 auto;">
          <div style="padding: 8px 12px; background: var(--hover-tint); border-radius: 6px; font-size: 0.8rem; color: var(--ink-secondary); margin-bottom: 12px;"><%= flash[:notice] %></div>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="px-4 md:px-8" style="max-width: 760px; margin: 0 auto;">
          <div style="padding: 8px 12px; background: rgba(192,64,64,0.1); border-radius: 6px; font-size: 0.8rem; color: #C04040; margin-bottom: 12px;"><%= flash[:alert] %></div>
        </div>
      <% end %>

      <!-- Log -->
      <div class="px-4 pb-16 md:px-8" style="max-width: 1100px; margin: 0 auto;">
        <% if @prompt.description.present? %>
          <div style="padding: 12px 16px; background: var(--hover-tint); border-radius: 8px; margin-bottom: 20px;">
            <p style="font-family: var(--font-body); font-size: 0.85rem; color: var(--ink-secondary); line-height: 1.5; margin: 0;"><%= simple_format(@prompt.description) %></p>
          </div>
        <% end %>

        <% if @responses.any? && @questions.any? %>
          <%# ── Table (wide screens) ── %>
          <div class="prompt-grid-scroll">
            <table class="prompt-grid">
              <thead>
                <tr>
                  <th class="col-when">When</th>
                  <% @questions.each do |q| %>
                    <th><%= q.text %></th>
                  <% end %>
                  <th class="col-actions">Edit</th>
                </tr>
              </thead>
              <tbody>
                <% @responses.each do |response| %>
                  <tr class="prompt-grid-row">
                    <td class="col-when">
                      <%= response.created_at.in_time_zone(current_user.timezone).strftime('%b %-d, %Y') %>
                      <span class="time-sub"><%= response.created_at.in_time_zone(current_user.timezone).strftime('%-l:%M %p') %></span>
                    </td>
                    <% @questions.each do |q| %>
                      <td class="<%= 'cell-long' if q.question_type == 'long_answer' %>">
                        <%= render 'answer_value', question: q, answer: response.answer_for(q), clamp: true %>
                      </td>
                    <% end %>
                    <td class="col-actions">
                      <div class="prompt-log-actions flex items-center gap-1">
                        <button type="button" @click="editingId = <%= response.id %>" class="v2-btn-icon-sm" title="Edit response">
                          <i class="fa-solid fa-pen" style="font-size: 0.6rem;"></i>
                        </button>
                        <%= button_to prompt_response_path(response), method: :delete, data: { confirm: "Delete this response?" }, class: "v2-btn-icon-sm", form: { style: "display: inline;" } do %>
                          <i class="fa-solid fa-trash" style="font-size: 0.6rem;"></i>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <%# ── Cards (narrow screens) — no horizontal scrolling at all ── %>
          <div class="prompt-cards">
            <% @responses.each do |response| %>
              <div class="prompt-response-card">
                <div class="prompt-response-card-head">
                  <div>
                    <div style="font-weight: 600; font-size: 0.82rem; color: var(--ink);">
                      <%= response.created_at.in_time_zone(current_user.timezone).strftime('%b %-d, %Y') %>
                    </div>
                    <div style="font-size: 0.72rem; color: var(--ink-tertiary);">
                      <%= response.created_at.in_time_zone(current_user.timezone).strftime('%-l:%M %p') %>
                    </div>
                  </div>
                  <div class="flex items-center gap-1" style="flex-shrink: 0;">
                    <button type="button" @click="editingId = <%= response.id %>" class="v2-btn-icon-sm" title="Edit response">
                      <i class="fa-solid fa-pen" style="font-size: 0.7rem;"></i>
                    </button>
                    <%= button_to prompt_response_path(response), method: :delete, data: { confirm: "Delete this response?" }, class: "v2-btn-icon-sm", form: { style: "display: inline;" } do %>
                      <i class="fa-solid fa-trash" style="font-size: 0.7rem;"></i>
                    <% end %>
                  </div>
                </div>
                <% @questions.each do |q| %>
                  <div class="prompt-response-field">
                    <div class="prompt-response-label"><%= q.text %></div>
                    <div class="prompt-response-answer">
                      <%= render 'answer_value', question: q, answer: response.answer_for(q) %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <%# ── Edit modals, one per response, kept out of the table ── %>
          <% @responses.each do |response| %>
            <template x-teleport="body">
              <div x-show="editingId === <%= response.id %>"
                   @click.self="editingId = null"
                   @keydown.escape.window="editingId = null"
                   class="fixed inset-0 flex items-center justify-center z-50 p-4"
                   style="background: rgba(0,0,0,0.4); display: none;">
                <div @click.stop class="v2-card" style="padding: 24px; width: 100%; max-width: 34rem; max-height: 90vh; overflow-y: auto;">
                  <h2 class="v2-h2" style="margin-bottom: 4px;">Edit Response</h2>
                  <p class="v2-small" style="color: var(--ink-tertiary); margin-bottom: 20px;">
                    <%= response.created_at.in_time_zone(current_user.timezone).strftime('%b %-d, %Y at %-l:%M %p') %>
                  </p>

                  <%= form_with model: response, url: prompt_response_path(response), method: :patch, local: true do |f| %>
                    <%= render 'answer_inputs', prompt: @prompt, response: response, questions: @questions %>

                    <div class="flex gap-2 justify-end" style="margin-top: 20px;">
                      <button type="button" @click="editingId = null" class="v2-btn v2-btn-secondary">Cancel</button>
                      <%= f.submit "Save", class: "v2-btn v2-btn-primary" %>
                    </div>
                  <% end %>
                </div>
              </div>
            </template>
          <% end %>
        <% elsif @questions.empty? %>
          <div class="v2-small" style="text-align: center; padding: 40px; color: var(--ink-tertiary);">
            No questions yet — add one from the edit modal to start logging answers.
          </div>
        <% else %>
          <div class="v2-small" style="text-align: center; padding: 40px; color: var(--ink-tertiary);">
            No responses yet. Answer this prompt from the <%= link_to "Prompts page", prompts_path, style: "color: var(--ink-secondary); text-decoration: underline;" %>.
          </div>
        <% end %>
      </div>

    </div>
  </main>
</div>
