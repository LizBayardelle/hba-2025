<%# Loads the shared SortableJS helper plus the drag-state styling.
    Include on any page that uses [data-sortable-item] / [data-sortable-url]. %>
<%= javascript_include_tag "sortable_lists", type: "module" %>

<style>
  [data-drag-handle] {
    cursor: grab;
    color: var(--ink-faint);
    flex-shrink: 0;
    touch-action: none; /* let Sortable own the gesture once it starts */
    background: none;
    border: none;
    padding: 4px 2px;
    line-height: 1;
  }
  [data-drag-handle]:active { cursor: grabbing; }
  [data-drag-handle]:hover { color: var(--ink-tertiary); }

  /* Placeholder gap the row will drop into */
  .hb-sortable-ghost {
    opacity: 0.35;
    background: var(--hover-tint-strong) !important;
  }
  /* The row being dragged */
  .hb-sortable-chosen { }
  .hb-sortable-drag {
    opacity: 0.95 !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  }
</style>
